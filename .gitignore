# No dependencies - project works out of the box.
# Add lines here if a real npm project appears.

# Compiled folder for static hosting: created by deploy.cmd
# recreated every time and not belonging in git.
deploy/

# Backend address: created from a repository secret during deploy
# or from tools/local-endpoint.txt during local run.
assets/js/generated/env.js
tools/local-endpoint.txt
local-pass.txt

